<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 需求 4.2：TRANSMIT_IR 为普通权限，安装即授予 -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />
    <!-- 定时关机：到点由系统唤醒并在后台发码，无需 App 保持运行 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android 13+ 上 SCHEDULE_EXACT_ALARM 默认不授予且需用户手动开启，
         这里声明 USE_EXACT_ALARM 让安装即生效，保证「运行 N 小时后关机」按点触发 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 需求 4.2：无红外设备的手机也应能安装，运行时再提示不支持 -->
    <uses-feature
        android:name="android.hardware.consumerir"
        android:required="false" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AirconRemote">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PresetEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.FrequencyTestActivity"
            android:exported="false" />

        <receiver
            android:name=".ir.AutoOffReceiver"
            android:exported="false" />
    </application>

</manifest>
