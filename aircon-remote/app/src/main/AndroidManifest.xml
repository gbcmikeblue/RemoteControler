<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 需求 4.2：TRANSMIT_IR 为普通权限，安装即授予 -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />

    <!-- 需求 4.2：无红外设备的手机也应能安装，运行时再提示不支持 -->
    <uses-feature
        android:name="android.hardware.consumerir"
        android:required="false" />

    <!-- Android 11+ 包可见性：配置检测需要枚举已安装的遥控类应用 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.duokan.phone.remotecontroller" />
        <package android:name="com.xiaomi.mitv.remotecontroller" />
        <package android:name="com.tiqiaa.remote" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AirconRemote">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PresetEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.FrequencyTestActivity"
            android:exported="false" />

        <activity
            android:name=".ui.RemoteConfigCheckActivity"
            android:exported="false" />
    </application>

</manifest>
